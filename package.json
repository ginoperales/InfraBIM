{
  "name": "infrabim-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/static-build.test.mjs",
    "lint": "eslint src --max-warnings=0",
    "firebase:login": "firebase login",
    "firebase:emulators": "firebase emulators:start --only hosting,auth,firestore",
    "worker:dev": "npx wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml",
    "worker:secret:mp": "npx wrangler secret put MERCADO_PAGO_ACCESS_TOKEN --config worker/wrangler.toml",
    "worker:secret:firebase": "npx wrangler secret put FIREBASE_SERVICE_ACCOUNT --config worker/wrangler.toml",
    "deploy": "firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "^15.26.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
