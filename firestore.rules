rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAccessOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/accessControl)
        && get(/databases/$(database)/documents/system/accessControl).data.ownerUid == request.auth.uid;
    }

    function hasAdminRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Administrador";
    }

    function isAdmin() {
      return isAccessOwner() || hasAdminRole();
    }

    function canCreateOwnUserProfile(uid) {
      return isOwner(uid)
        && (
          !request.resource.data.keys().hasAny(["role"])
          || request.resource.data.role == "Usuario"
          || (
            request.resource.data.role == "Administrador"
            && !exists(/databases/$(database)/documents/system/accessControl)
          )
        );
    }

    function canUpdateOwnUserProfile(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "updatedAt"
        ]);
    }

    match /system/accessControl {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/accessControl);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /system/paymentPlans {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if canCreateOwnUserProfile(uid);
      allow update: if isAdmin() || canUpdateOwnUserProfile(uid);
      allow delete: if isAdmin() && request.auth.uid != uid;

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /bimObjects/{objectId} {
      allow read: if true;
      allow create, update: if isVerified() || isAdmin();
      allow delete: if isAdmin();
    }

    match /catalogItems/{itemId} {
      allow read: if true;
      allow create, update: if isVerified() || isAdmin();
      allow delete: if isAdmin();
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow create, update: if isVerified() || isAdmin();
      allow delete: if isAdmin();
    }

    match /driveFiles/{fileId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /paymentWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read, update: if isAdmin() || (signedIn() && request.auth.uid in resource.data.memberIds);
      allow create: if isAdmin() || (signedIn() && request.auth.uid in request.resource.data.memberIds);
      allow delete: if isAdmin();
    }
  }
}
